{
    "name": "mealwise",
    "private": true,
    "type": "module",
    "engines": {
        "node": "26.x"
    },
    "workspaces": [
        "client",
        "server"
    ],
    "scripts": {
        "dev": "concurrently -n client,server -c cyan,green \"npm run dev -w client\" \"npm run dev -w server\"",
        "build": "npm run build -w client",
        "start": "npm start -w server",
        "db:reset": "npm run db:reset -w server",
        "db:dump": "npm run db:dump -w server",
        "db:restore": "npm run db:restore -w server --",
        "lint": "npm run lint --workspaces",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky"
    },
    "lint-staged": {
        "*": "prettier --write --ignore-unknown"
    },
    "devDependencies": {
        "concurrently": "^10.0.7",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.10.1"
    }
}
